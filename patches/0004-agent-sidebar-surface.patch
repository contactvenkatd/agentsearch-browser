+void HorizontalTabStripRegionViewOld::OnAgentSearchTogglePressed() {
+  SidePanelUI* side_panel_ui = SidePanelUI::From(browser_view_->browser());
+  if (!side_panel_ui) {
+    return;
+  }
+  if (agent_search_toggle_->GetIsOn()) {
+    side_panel_ui->Show(SidePanelEntry::Id::kAgentSearch);
+  } else if (side_panel_ui->GetCurrentEntryId() ==
+             SidePanelEntry::Id::kAgentSearch) {
+    side_panel_ui->Close();
+  }
+}
+
+void HorizontalTabStripRegionViewOld::ShowAgentSearchSidebar() {
+  SidePanelUI* side_panel_ui = SidePanelUI::From(browser_view_->browser());
+  if (side_panel_ui && agent_search_toggle_->GetIsOn()) {
+    side_panel_ui->Show(SidePanelEntry::Id::kAgentSearch);
+  }
+}
