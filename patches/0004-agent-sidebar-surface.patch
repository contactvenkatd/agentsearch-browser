diff --git a/chrome/browser/resources/history/app.ts b/chrome/browser/resources/history/app.ts
index 3bb9d2e8ec..854a7724cf 100644
--- a/chrome/browser/resources/history/app.ts
+++ b/chrome/browser/resources/history/app.ts
@@ -57,6 +57,28 @@ import {Page, TABBED_PAGES} from './router.js';
 import type {HistoryRouterElement} from './router.js';
 import type {FooterInfo, HistorySideBarElement} from './side_bar.js';
 
+export interface AgentSearchSearchEntry {
+  query: string;
+  category: string;
+  timestamp: number;
+}
+
+export interface AgentSearchChatEntry {
+  role: 'user'|'agent';
+  text: string;
+  timestamp: number;
+}
+
+function parseAgentSearchHistory<T>(key: string): T[] {
+  try {
+    const value = JSON.parse(loadTimeData.getString(key));
+    return Array.isArray(value) ? value as T[] : [];
+  } catch (error) {
+    console.error(`AgentSearch history parse failed for ${key}:`, error);
+    return [];
+  }
+}
+
 // Click/auxclick listeners to intercept any link clicks. If the link points
 // to a chrome: or file: url, then calls into the browser to do the
 // navigation.
