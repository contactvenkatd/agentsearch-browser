@@ -144,7 +144,12 @@ void ToolbarActionsModel::OnExtensionInstalled(
 
   // We can only pin extensions that have a toolbar action.
   if (should_add_extension) {
-    if (is_pinned_by_policy || is_pinned_by_feature) {
+    // External policy installs can report installation after the action has
+    // already been restored as pinned from the profile pref. SetActionVisibility
+    // intentionally DCHECKs unless it changes state, so keep this observer
+    // idempotent instead of attempting to pin an already-pinned action.
+    if ((is_pinned_by_policy || is_pinned_by_feature) &&
+        !IsActionPinned(extension->id())) {
       SetActionVisibility(extension->id(), true);
     }
   }
