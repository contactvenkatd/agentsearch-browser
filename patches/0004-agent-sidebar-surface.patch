From 0000000000000000000000000000000000000004 Mon Sep 17 00:00:00 2001
From: contactvenkatd <contactvenkatd@gmail.com>
Date: Tue, 9 Sep 2026 10:00:00 -0700
Subject: [PATCH 4/5] Agent sidebar surface and history integration

Adds the Agent Search side panel view, registers its side panel entry,
action id and toolbar affordances, and extends the history WebUI with
the agent session surface.

---
diff --git a/chrome/browser/resources/history/app.css b/chrome/browser/resources/history/app.css
index d736376221..f0595c9283 100644
--- a/chrome/browser/resources/history/app.css
+++ b/chrome/browser/resources/history/app.css
@@ -123,3 +123,46 @@ cr-history-embeddings-filter-chips ~ #tabsContent {
 cr-history-embeddings {
   margin-block-end: var(--card-padding-between);
 }
+
+.agentsearch-history-page {
+  box-sizing: border-box;
+  height: 100%;
+  overflow: auto;
+  padding: 24px 24px 32px;
+}
+
+.agentsearch-history-card {
+  background: var(--cr-card-background-color);
+  border-radius: 12px;
+  box-shadow: var(--cr-card-shadow);
+  margin: 0 auto;
+  max-width: 960px;
+  padding: 20px;
+}
+
+.agentsearch-history-card h2 {
+  color: var(--cr-primary-text-color);
+  font-size: 18px;
+  margin: 0 0 14px;
+}
+
+.agentsearch-history-row {
+  border-top: 1px solid var(--cr-separator-color);
+  padding: 12px 0;
+}
+
+.agentsearch-history-row:first-of-type {
+  border-top: 0;
+}
+
+.agentsearch-history-primary {
+  color: var(--cr-primary-text-color);
+  font-size: 14px;
+}
+
+.agentsearch-history-meta,
+.agentsearch-history-empty {
+  color: var(--cr-secondary-text-color);
+  font-size: 12px;
+  margin-top: 4px;
+}
