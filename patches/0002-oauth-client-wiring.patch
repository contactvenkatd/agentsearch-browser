 using ::base::i18n::LanguageTagConverter;
 
+constexpr char kAgentSearchBitwardenExtensionId[] =
+    "nngceckbapebfimnlniiiahkandclblb";
+constexpr char kChromeWebStoreUpdateUrl[] =
+    "https://clients2.google.com/service/update2/crx";
+
+class AgentSearchBitwardenExternalLoader : public ExternalLoader {
+ public:
+  AgentSearchBitwardenExternalLoader() = default;
+
+  void StartLoading() override {
+    base::DictValue prefs;
+    prefs.SetByDottedPath(
+        std::string(kAgentSearchBitwardenExtensionId) +
+            ".external_update_url",
+        kChromeWebStoreUpdateUrl);
+    LoadFinished(std::move(prefs));
+  }
+
+ private:
+  ~AgentSearchBitwardenExternalLoader() override = default;
+};
+
