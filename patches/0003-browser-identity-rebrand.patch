From 0000000000000000000000000000000000000003 Mon Sep 17 00:00:00 2001
From: contactvenkatd <contactvenkatd@gmail.com>
Date: Tue, 9 Sep 2026 10:00:00 -0700
Subject: [PATCH 3/5] Browser identity rebrand to AgentSearch

Renames the Chromium product to AgentSearch across BRANDING, strings,
Info.plist and build config, and replaces app/product icon assets.
Contains binary icon data, so apply with git am (not git apply --3way).

---
diff --git a/build/BUILD.gn b/build/BUILD.gn
index 3fa5cae7e1..09915917f2 100644
--- a/build/BUILD.gn
+++ b/build/BUILD.gn
@@ -33,6 +33,8 @@ buildflag_header("branding_buildflags") {
     ]
   }
 
+  flags += [ "AGENTSEARCH_BRANDING=$is_agentsearch_branded" ]
+
   if (is_chrome_for_testing) {
     assert(!is_chrome_branded,
            "`is_chrome_for_testing` is incompatible with `is_chrome_branded`")
diff --git a/build/config/chrome_build.gni b/build/config/chrome_build.gni
index d80c9ff95a..fb84cfbebe 100644
--- a/build/config/chrome_build.gni
+++ b/build/config/chrome_build.gni
@@ -49,6 +49,13 @@ declare_args() {
   }
 }
 
+declare_args() {
+  # This fork's Chromium branding is the AgentSearch product. Keep product
+  # behavior available as an explicit build flag rather than relying on launch
+  # switches or runtime bundle-name checks.
+  is_agentsearch_branded = !is_chrome_branded && !is_chrome_for_testing
+}
+
 # Use this for is_chrome_branded things that live in src-internal.
 # See: b/452971335
 is_internal_chrome_branded = enable_src_internal && is_chrome_branded
diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index 7873418e78..cb92bc5dd3 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -667,7 +667,6 @@ if (is_win) {
     public_deps = [
       ":chrome_app_icon",
       ":chrome_app_strings",
-      ":chrome_asset_catalog",
       "//components/policy:chrome_manifest_bundle",
     ]
   }
diff --git a/chrome/app/app-Info.plist b/chrome/app/app-Info.plist
index 6fada0a2b1..50deff6426 100644
--- a/chrome/app/app-Info.plist
+++ b/chrome/app/app-Info.plist
@@ -153,6 +153,8 @@
 	<string>AppIcon</string>
 	<key>CFBundleIdentifier</key>
 	<string>${CHROMIUM_BUNDLE_ID}</string>
+	<key>CrProductDirName</key>
+	<string>AgentSearch</string>
 	<key>CFBundleInfoDictionaryVersion</key>
 	<string>6.0</string>
 	<key>CFBundleName</key>
diff --git a/chrome/app/chrome_main_delegate.cc b/chrome/app/chrome_main_delegate.cc
index 45f00944bf..c631bfb585 100644
--- a/chrome/app/chrome_main_delegate.cc
+++ b/chrome/app/chrome_main_delegate.cc
@@ -1067,6 +1067,19 @@ void ChromeMainDelegate::SetupTracing() {
 }
 
 std::optional<int> ChromeMainDelegate::BasicStartupComplete() {
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX)
+  // AgentSearch's loopback companion controls the active tab through CDP. The
+  // Chrome DevTools server binds its TCP socket to 127.0.0.1/::1. Preserve any
+  // explicit port or pipe selected by the user.
+  base::CommandLine* mutable_command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!mutable_command_line->HasSwitch(switches::kProcessType) &&
+      !mutable_command_line->HasSwitch(::switches::kRemoteDebuggingPort) &&
+      !mutable_command_line->HasSwitch(::switches::kRemoteDebuggingPipe)) {
+    mutable_command_line->AppendSwitchASCII(::switches::kRemoteDebuggingPort,
+                                            "9222");
+  }
+#endif
 #if BUILDFLAG(IS_CHROMEOS)
   ash::BootTimesRecorder::Get()->SaveChromeMainStats();
 #endif
diff --git a/chrome/app/chromium_strings.grd b/chrome/app/chromium_strings.grd
index d19c217870..553bef9468 100644
--- a/chrome/app/chromium_strings.grd
+++ b/chrome/app/chromium_strings.grd
@@ -294,15 +294,15 @@ If you update this file, be sure also to update google_chrome_strings.grd. -->
         </then>
         <else>
           <message name="IDS_PRODUCT_NAME" desc="The Chrome application name" translateable="false">
-            Chromium
+            AgentSearch
           </message>
           <message name="IDS_SHORT_PRODUCT_NAME" desc="The Chrome application short name." translateable="false">
-            Chromium
+            AgentSearch
           </message>
         </else>
       </if>
       <message name="IDS_APP_MENU_YOUR_CHROME_HEADER" desc="Header title for the Your Chromium section in the main App Menu">
-        Your Chromium
+        Your AgentSearch
       </message>
       <if expr="is_win">
         <message name="IDS_SXS_SHORTCUT_NAME" desc="Unused in Chromium builds" translateable="false">
@@ -320,7 +320,7 @@ If you update this file, be sure also to update google_chrome_strings.grd. -->
       </if>
       <if expr="is_macosx or is_linux">
         <message name="IDS_FIRST_RUN_DIALOG_WINDOW_TITLE" desc="Window title of First Run dialog on Mac and Linux, displayed in title bar">
-          Welcome to Chromium
+          Welcome to AgentSearch
         </message>
       </if>
       <if expr="is_linux">
@@ -1089,7 +1089,7 @@ Chromium is unable to recover your settings.
           </then>
           <else>
             <message name="IDS_ABOUT" desc="In Title Case: The text label of the About Chrome menu item">
-              About &amp;Chromium
+              About &amp;AgentSearch
             </message>
           </else>
         </if>
@@ -1106,7 +1106,7 @@ Chromium is unable to recover your settings.
           </then>
           <else>
             <message name="IDS_ABOUT" desc="The text label of the About Chrome menu item">
-              About &amp;Chromium
+              About &amp;AgentSearch
             </message>
           </else>
         </if>
@@ -1125,13 +1125,13 @@ Chromium is unable to recover your settings.
 
       <if expr="is_macosx">
         <message name="IDS_APP_MENU_PRODUCT_NAME" desc="The application's short name, used for the Mac's application menu, activity monitor, etc. This should be less than 16 characters. Example: Chrome, not Google Chrome." translateable="false">
-          Chromium
+          AgentSearch
         </message>
         <message name="IDS_HELPER_NAME" desc="The helper application's name.  Should contain the Chrome application name (IDS_PRODUCT_NAME). Example: Google Chrome Helper.">
-          Chromium Helper
+          AgentSearch Helper
         </message>
         <message name="IDS_SHORT_HELPER_NAME" desc="The helper application's short name, used for the Mac's application menu, activity monitor, etc. Example: Chrome Helper, not Google Chrome Helper.">
-          Chromium Helper
+          AgentSearch Helper
         </message>
       </if>
 
