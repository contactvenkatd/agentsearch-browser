index 429ece9d50..83ea8e6169 100644
--- a/chrome/app/generated_resources.grd
+++ b/chrome/app/generated_resources.grd
@@ -7449,7 +7449,7 @@ Keep your key file in a safe place. You will need it to create new versions of y
