+class AgentSearchOAuthNavigationObserver
+    : public content::WebContentsObserver {
+ public:
+  using Callback =
+      base::RepeatingCallback<void(const GURL&, content::WebContents*)>;
+
+  AgentSearchOAuthNavigationObserver(content::WebContents* web_contents,
+                                     Callback callback)
+      : content::WebContentsObserver(web_contents),
+        callback_(std::move(callback)) {}
+
+  void DidStartNavigation(content::NavigationHandle* navigation) override {
+    if (!navigation->IsInPrimaryMainFrame()) {
+      return;
+    }
+    const GURL& url = navigation->GetURL();
+    if (url.SchemeIs(url::kHttpScheme) && url.host() == "localhost") {
+      callback_.Run(url, web_contents());
+    }
+  }
+
+  void Detach() { Observe(nullptr); }
+
+ private:
+  Callback callback_;
+};
