+class AgentSearchMessageHandler : public content::WebUIMessageHandler {
+ public:
+  AgentSearchMessageHandler() = default;
+  ~AgentSearchMessageHandler() override = default;
+
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "agentSearch",
+        base::BindRepeating(&AgentSearchMessageHandler::HandleSearch,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "agentSearchLocation",
+        base::BindRepeating(&AgentSearchMessageHandler::HandleLocation,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "agentSearchWeather",
+        base::BindRepeating(&AgentSearchMessageHandler::HandleWeather,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "agentSearchIdentity",
+        base::BindRepeating(&AgentSearchMessageHandler::HandleIdentity,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "agentSearchShowSignin",
+        base::BindRepeating(&AgentSearchMessageHandler::HandleShowSignin,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "agentSearchSignOut",
+        base::BindRepeating(&AgentSearchMessageHandler::HandleSignOut,
+                            base::Unretained(this)));
+  }
+
+ private:
+  void OnJavascriptAllowed() override {
+    profile_ = Profile::FromWebUI(web_ui());
+    if (!pref_change_registrar_.prefs()) {
+      pref_change_registrar_.Init(profile_->GetPrefs());
+      pref_change_registrar_.Add(
+          kAgentSearchOAuthProfilePref,
+          base::BindRepeating(&AgentSearchMessageHandler::NotifyIdentityChanged,
+                              base::Unretained(this)));
+    }
+  }
+
+  void OnJavascriptDisallowed() override {
+    pref_change_registrar_.RemoveAll();
+    profile_ = nullptr;
+  }
+
+  base::DictValue BuildIdentityState() const {
+    base::DictValue state;
+    state.Set("signedIn", false);
+    state.Set("name", "");
+    state.Set("email", "");
+    state.Set("avatarUrl", "");
+    if (!profile_) {
+      return state;
+    }
+    const base::DictValue& profile_data =
+        profile_->GetPrefs()->GetDict(kAgentSearchOAuthProfilePref);
+    const std::string* email = profile_data.FindString("email");
+    if (!email || email->empty()) {
+      return state;
+    }
+    state.Set("signedIn", true);
+    state.Set("email", *email);
+    state.Set("name", profile_data.FindString("name")
+                          ? *profile_data.FindString("name")
+                          : std::string());
+    const std::string* picture = profile_data.FindString("picture");
+    if (picture && GURL(*picture).SchemeIs(url::kHttpsScheme)) {
+      GURL sanitized_avatar(chrome::kChromeUIImageURL);
+      sanitized_avatar =
+          net::AppendQueryParameter(sanitized_avatar, "url", *picture);
+      sanitized_avatar = net::AppendQueryParameter(
+          sanitized_avatar, "staticEncode", "true");
+      state.Set("avatarUrl", sanitized_avatar.spec());
+    }
+    return state;
+  }
+
+  void HandleIdentity(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() != 1u || !args[0].is_string()) {
+      return;
+    }
+    ResolveJavascriptCallback(args[0], BuildIdentityState());
+  }
+
+  void HandleShowSignin(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() != 1u || !args[0].is_string()) {
+      return;
+    }
+    if (BuildIdentityState().FindBool("signedIn").value_or(false)) {
+      ResolveJavascriptCallback(args[0], base::Value(true));
+      return;
+    }
+
+    oauth_state_ = base::UnguessableToken::Create().ToString();
+    GURL authorize_url(kAgentSearchOAuthAuthorizeUrl);
+    authorize_url = net::AppendQueryParameter(
+        authorize_url, "client_id",
+        google_apis::GetOAuth2ClientID(google_apis::CLIENT_MAIN));
+    authorize_url = net::AppendQueryParameter(authorize_url, "redirect_uri",
+                                               kAgentSearchOAuthRedirectUri);
+    authorize_url = net::AppendQueryParameter(authorize_url, "response_type",
+                                               "code");
+    authorize_url = net::AppendQueryParameter(
+        authorize_url, "scope",
+        "openid email profile");
+    authorize_url =
+        net::AppendQueryParameter(authorize_url, "state", oauth_state_);
+    authorize_url =
+        net::AppendQueryParameter(authorize_url, "access_type", "offline");
+    authorize_url =
+        net::AppendQueryParameter(authorize_url, "prompt", "select_account");
+
+    NavigateParams params(profile_, authorize_url, ui::PAGE_TRANSITION_LINK);
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    params.browser = GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+        web_ui()->GetWebContents());
+    Navigate(&params);
+    if (!params.navigated_or_inserted_contents) {
+      RejectJavascriptCallback(args[0], base::Value("Could not open OAuth tab"));
+      return;
+    }
+    oauth_observer_ = std::make_unique<AgentSearchOAuthNavigationObserver>(
+        params.navigated_or_inserted_contents,
+        base::BindRepeating(&AgentSearchMessageHandler::OnOAuthCallback,
+                            weak_ptr_factory_.GetWeakPtr()));
+    ResolveJavascriptCallback(args[0], base::Value(true));
+  }
+
+  void HandleSignOut(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() != 1u || !args[0].is_string()) {
+      return;
+    }
+    profile_->GetPrefs()->ClearPref(kAgentSearchOAuthProfilePref);
+    ResolveJavascriptCallback(args[0], base::Value(true));
+  }
+
+  void OnOAuthCallback(const GURL& callback_url,
+                       content::WebContents* oauth_contents) {
+    std::string returned_state;
+    std::string code;
+    std::string error;
+    net::GetValueForKeyInQuery(callback_url, "state", &returned_state);
+    net::GetValueForKeyInQuery(callback_url, "code", &code);
+    net::GetValueForKeyInQuery(callback_url, "error", &error);
+    if (returned_state != oauth_state_ || code.empty() || !error.empty()) {
+      LOG(ERROR) << "AgentSearch OAuth callback rejected: state_valid="
+                 << (returned_state == oauth_state_)
+                 << " code_present=" << !code.empty()
+                 << " provider_error_present=" << !error.empty();
+      return;
+    }
+
+    oauth_observer_->Detach();
+    oauth_contents->ClosePage();
+    StartOAuthTokenExchange(code);
+  }
+
+  void StartOAuthTokenExchange(const std::string& code) {
+    const GaiaUrls* gaia_urls = GaiaUrls::GetInstance();
+    std::string body = base::StrCat(
+        {"code=", base::EscapeUrlEncodedData(code, true),
+         "&client_id=",
+         base::EscapeUrlEncodedData(
+             google_apis::GetOAuth2ClientID(google_apis::CLIENT_MAIN), true),
+         "&client_secret=",
+         base::EscapeUrlEncodedData(
+             google_apis::GetOAuth2ClientSecret(google_apis::CLIENT_MAIN),
+             true),
+         "&redirect_uri=",
+         base::EscapeUrlEncodedData(kAgentSearchOAuthRedirectUri, true),
+         "&grant_type=authorization_code"});
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = gaia_urls->oauth2_token_url();
+    request->method = "POST";
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    net::NetworkTrafficAnnotationTag traffic_annotation =
+        net::DefineNetworkTrafficAnnotation("agentsearch_oauth_token_exchange", R"(
+          semantics {
+            sender: "AgentSearch dashboard OAuth"
+            description: "Exchanges a user-authorized OAuth code for tokens."
+            trigger: "The user completes Google OAuth consent."
+            data: "OAuth authorization code and configured client credentials."
+            destination: GOOGLE_OWNED_SERVICE
+          }
+          policy {
+            cookies_allowed: NO
+            setting: "Initiated only by the dashboard Sign in button."
+            policy_exception_justification: "AgentSearch account display feature."
+          })");
+    oauth_token_loader_ =
+        network::SimpleURLLoader::Create(std::move(request), traffic_annotation);
+    oauth_token_loader_->AttachStringForUpload(
+        body, "application/x-www-form-urlencoded");
+    oauth_token_loader_->DownloadToString(
+        profile_->GetDefaultStoragePartition()
+            ->GetURLLoaderFactoryForBrowserProcess()
+            .get(),
+        base::BindOnce(&AgentSearchMessageHandler::OnOAuthTokenExchangeComplete,
+                       weak_ptr_factory_.GetWeakPtr()),
+        kAgentSearchOAuthMaxResponseBytes);
+  }
+
+  void OnOAuthTokenExchangeComplete(std::optional<std::string> body) {
+    if (!body) {
+      LOG(ERROR) << "AgentSearch OAuth token exchange failed";
+      return;
+    }
+    std::optional<base::Value> value =
+        base::JSONReader::Read(*body, base::JSON_PARSE_RFC);
+    const std::string* access_token =
+        value && value->is_dict() ? value->GetDict().FindString("access_token")
+                                  : nullptr;
+    if (!access_token || access_token->empty()) {
+      LOG(ERROR) << "AgentSearch OAuth token response lacked an access token";
+      return;
+    }
+    StartOAuthUserInfoRequest(*access_token);
+  }
+
+  void StartOAuthUserInfoRequest(const std::string& access_token) {
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = GaiaUrls::GetInstance()->oauth_user_info_url();
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
+                               base::StrCat({"Bearer ", access_token}));
+    net::NetworkTrafficAnnotationTag traffic_annotation =
+        net::DefineNetworkTrafficAnnotation("agentsearch_oauth_user_info", R"(
+          semantics {
+            sender: "AgentSearch dashboard OAuth"
+            description: "Fetches the signed-in user's basic display profile."
+            trigger: "A dashboard OAuth token exchange succeeds."
+            data: "OAuth access token."
+            destination: GOOGLE_OWNED_SERVICE
+          }
+          policy {
+            cookies_allowed: NO
+            setting: "Initiated only by the dashboard Sign in button."
+            policy_exception_justification: "AgentSearch account display feature."
+          })");
+    oauth_userinfo_loader_ =
+        network::SimpleURLLoader::Create(std::move(request), traffic_annotation);
+    oauth_userinfo_loader_->DownloadToString(
+        profile_->GetDefaultStoragePartition()
+            ->GetURLLoaderFactoryForBrowserProcess()
+            .get(),
+        base::BindOnce(&AgentSearchMessageHandler::OnOAuthUserInfoComplete,
+                       weak_ptr_factory_.GetWeakPtr()),
+        kAgentSearchOAuthMaxResponseBytes);
+  }
+
+  void OnOAuthUserInfoComplete(std::optional<std::string> body) {
+    if (!body) {
+      LOG(ERROR) << "AgentSearch OAuth userinfo request failed";
+      return;
+    }
+    std::optional<base::Value> value =
+        base::JSONReader::Read(*body, base::JSON_PARSE_RFC);
+    if (!value || !value->is_dict()) {
+      LOG(ERROR) << "AgentSearch OAuth userinfo response was invalid";
+      return;
+    }
+    const base::DictValue& user_info = value->GetDict();
+    const std::string* email = user_info.FindString("email");
+    if (!email || email->empty()) {
+      LOG(ERROR) << "AgentSearch OAuth userinfo response lacked email";
+      return;
+    }
+    base::DictValue stored_profile;
+    stored_profile.Set("email", *email);
+    stored_profile.Set("name", user_info.FindString("name")
+                                   ? *user_info.FindString("name")
+                                   : std::string());
+    stored_profile.Set("picture", user_info.FindString("picture")
+                                      ? *user_info.FindString("picture")
+                                      : std::string());
+    profile_->GetPrefs()->SetDict(kAgentSearchOAuthProfilePref,
+                                  std::move(stored_profile));
+    LOG(INFO) << "AgentSearch OAuth profile stored successfully";
+  }
+
+  void NotifyIdentityChanged() {
+    if (IsJavascriptAllowed()) {
+      FireWebUIListener("agent-search-identity-changed",
+                        BuildIdentityState());
+    }
+  }
+
+  void HandleSearch(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    const base::Value& callback_id = args[0];
+    if (args.size() != 3u || !args[1].is_string() || !args[2].is_string()) {
+      RejectJavascriptCallback(callback_id,
+                               base::Value("Invalid search arguments"));
+      return;
+    }
+    const std::string& query = args[1].GetString();
+    const std::string& category = args[2].GetString();
+    if (category != "general" && category != "news" &&
+        category != "images" && category != "videos" &&
+        category != "map") {
+      RejectJavascriptCallback(callback_id,
+                               base::Value("Invalid search category"));
+      return;
+    }
+
+    base::ListValue search_history =
+        Profile::FromWebUI(web_ui())
+            ->GetPrefs()
+            ->GetList(kAgentSearchSearchHistoryPref)
+            .Clone();
+    base::DictValue entry;
+    entry.Set("query", query);
+    entry.Set("category", category);
+    entry.Set("timestamp", static_cast<double>(
+                               base::Time::Now().InMillisecondsSinceUnixEpoch()));
+    search_history.Append(std::move(entry));
+    while (search_history.size() > 200u) {
+      search_history.erase(search_history.begin());
+    }
+    Profile::FromWebUI(web_ui())
+        ->GetPrefs()
+        ->SetList(kAgentSearchSearchHistoryPref, std::move(search_history));
+    LOG(INFO) << "AgentSearch search history: wrote query; count="
+              << Profile::FromWebUI(web_ui())
+                     ->GetPrefs()
+                     ->GetList(kAgentSearchSearchHistoryPref)
+                     .size();
+
+    if (category == "general") {
+      std::unique_ptr<base::Environment> environment =
+          base::Environment::Create();
+      std::optional<std::string> api_key =
+          environment->GetVar(kAgentSearchGoogleApiKeyEnvironment);
+      std::optional<std::string> engine_id =
+          environment->GetVar(kAgentSearchGoogleEngineIdEnvironment);
+      if (api_key && engine_id &&
+          agent_search::HasGoogleConfiguration(*api_key, *engine_id)) {
+        StartGoogleSearch(callback_id.Clone(), query, *api_key, *engine_id);
+        return;
+      }
+    }
+    StartSearxSearch(callback_id.Clone(), query, category, 0u);
+  }
+
+  void StartGoogleSearch(base::Value callback_id,
+                         const std::string& query,
+                         const std::string& api_key,
+                         const std::string& engine_id) {
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url =
+        agent_search::BuildGoogleSearchUrl(api_key, engine_id, query);
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    net::NetworkTrafficAnnotationTag traffic_annotation =
+        net::DefineNetworkTrafficAnnotation("agentsearch_google_search", R"(
+          semantics {
+            sender: "AgentSearch results page"
+            description:
+              "Fetches general web-search results from the configured Google "
+              "Programmable Search Engine after the user submits a query."
+            trigger: "The user submits a general AgentSearch query."
+            data: "The search query, API key, and search engine identifier."
+            destination: GOOGLE_OWNED_SERVICE
+          }
+          policy {
+            cookies_allowed: NO
+            setting:
+              "This runs only when the local AgentSearch Google search "
+              "environment variables are configured."
+            policy_exception_justification:
+              "No enterprise policy is provided for this local integration."
+          })");
+    loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                               traffic_annotation);
+    loader_->SetAllowHttpErrorResults(true);
+    loader_->SetTimeoutDuration(kAgentSearchEngineTimeout);
+    const base::TimeTicks started_at = base::TimeTicks::Now();
+    loader_->DownloadToString(
+        web_ui()->GetWebContents()
+            ->GetBrowserContext()
+            ->GetDefaultStoragePartition()
+            ->GetURLLoaderFactoryForBrowserProcess()
+            .get(),
+        base::BindOnce(&AgentSearchMessageHandler::OnGoogleSearchComplete,
+                       weak_ptr_factory_.GetWeakPtr(), std::move(callback_id),
+                       query, started_at),
+        kAgentSearchMaxResponseBytes);
+  }
+
+  void StartSearxSearch(base::Value callback_id,
+                        const std::string& query,
+                        const std::string& category,
+                        size_t engine_index) {
+    GURL url(kAgentSearchEndpoint);
+    url = net::AppendQueryParameter(url, "q", query);
+    url = net::AppendQueryParameter(url, "format", "json");
+    url = net::AppendQueryParameter(url, "language", "en-US");
+    url = net::AppendQueryParameter(url, "safesearch", "0");
+    if (category == "general") {
+      CHECK_LT(engine_index, agent_search::SearxFallbackEngines().size());
+      url = net::AppendQueryParameter(
+          url, "engines", agent_search::SearxFallbackEngines()[engine_index]);
+    } else {
+      url = net::AppendQueryParameter(url, "categories", category);
+    }
+
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = url;
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    net::NetworkTrafficAnnotationTag traffic_annotation =
+        net::DefineNetworkTrafficAnnotation("agentsearch_searxng_search", R"(
+          semantics {
+            sender: "AgentSearch results page"
+            description:
+              "Fetches search results from the configured AgentSearch SearXNG "
+              "backend after the user submits a query."
+            trigger: "The user submits a search from an AgentSearch page."
+            data: "The search query and selected result category."
+            destination: OTHER
+          }
+          policy {
+            cookies_allowed: NO
+            setting:
+              "This is initiated only by an explicit user search action."
+            policy_exception_justification:
+              "No enterprise policy is provided for the product backend."
+          })");
+    loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                               traffic_annotation);
+    loader_->SetTimeoutDuration(category == "general"
+                                    ? kAgentSearchEngineTimeout
+                                    : kAgentSearchTimeout);
+    const base::TimeTicks started_at = base::TimeTicks::Now();
+    loader_->DownloadToString(
+        web_ui()->GetWebContents()
+            ->GetBrowserContext()
+            ->GetDefaultStoragePartition()
+            ->GetURLLoaderFactoryForBrowserProcess()
+            .get(),
+        base::BindOnce(&AgentSearchMessageHandler::OnSearchComplete,
+                       weak_ptr_factory_.GetWeakPtr(), std::move(callback_id),
+                       query, category, engine_index, started_at),
+        kAgentSearchMaxResponseBytes);
+  }
+
+  void OnGoogleSearchComplete(base::Value callback_id,
+                              std::string query,
+                              base::TimeTicks started_at,
+                              std::optional<std::string> body) {
+    const bool network_ok = loader_ && loader_->NetError() == net::OK;
+    const int http_status =
+        network_ok && loader_->ResponseInfo() &&
+                loader_->ResponseInfo()->headers
+            ? loader_->ResponseInfo()->headers->response_code()
+            : 0;
+    const bool content_type_ok =
+        network_ok && loader_->ResponseInfo() &&
+        loader_->ResponseInfo()->mime_type == "application/json";
+    agent_search::NormalizedResponse normalized;
+    if (network_ok && body) {
+      normalized = agent_search::NormalizeGoogleResponse(*body, query);
+    }
+    const bool success = http_status >= 200 && http_status <= 299 &&
+                         content_type_ok &&
+                         normalized.status ==
+                             agent_search::ResponseStatus::kSuccess;
+    VLOG(1) << "AgentSearch provider=google latency_ms="
+            << (base::TimeTicks::Now() - started_at).InMilliseconds()
+            << " http_status=" << http_status
+            << " result_count=" << normalized.result_count
+            << " outcome=" << (success ? "used" : "fallback");
+    if (success) {
+      ResolveJavascriptCallback(callback_id,
+                                base::Value(std::move(normalized.json)));
+      return;
+    }
+    StartSearxSearch(std::move(callback_id), query, "general", 0u);
+  }
+
+  void OnSearchComplete(base::Value callback_id,
+                        std::string query,
+                        std::string category,
+                        size_t engine_index,
+                        base::TimeTicks started_at,
+                        std::optional<std::string> body) {
+    const bool network_ok = loader_ && loader_->NetError() == net::OK;
+    const bool http_ok =
+        network_ok && loader_->ResponseInfo() &&
+        loader_->ResponseInfo()->headers &&
+        loader_->ResponseInfo()->headers->response_code() >= 200 &&
+        loader_->ResponseInfo()->headers->response_code() <= 299;
+    agent_search::NormalizedResponse normalized;
+    if (http_ok && body) {
+      normalized = agent_search::NormalizeSearxResponse(
+          *body, query, category == "general");
+    }
+    const bool usable =
+        normalized.status == agent_search::ResponseStatus::kSuccess;
+    if (usable) {
+      if (category == "general") {
+        VLOG(1) << "AgentSearch engine="
+                << agent_search::SearxFallbackEngines()[engine_index]
+                << " latency_ms="
+                << (base::TimeTicks::Now() - started_at).InMilliseconds()
+                << " usable_results=" << normalized.result_count
+                << " outcome=used";
+      }
+      ResolveJavascriptCallback(callback_id,
+                                base::Value(std::move(normalized.json)));
+      return;
+    }
+
+    if (category == "general") {
+      VLOG(1) << "AgentSearch engine="
+              << agent_search::SearxFallbackEngines()[engine_index]
+              << " latency_ms="
+              << (base::TimeTicks::Now() - started_at).InMilliseconds()
+              << " usable_results=" << normalized.result_count
+              << " outcome=fallback";
+      if (++engine_index < agent_search::SearxFallbackEngines().size()) {
+        StartSearxSearch(std::move(callback_id), query, category, engine_index);
+        return;
+      }
+      RejectJavascriptCallback(
+          callback_id, base::Value("Search providers unavailable"));
+      return;
+    }
+    RejectJavascriptCallback(callback_id,
+                             base::Value("Search service unavailable"));
+  }
+
+  void HandleLocation(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.size() != 1u || !args[0].is_string()) {
+      return;
+    }
+
+    GURL url(kAgentSearchLocationEndpoint);
+    url = net::AppendQueryParameter(url, "localityLanguage", "en");
+    StartWeatherRequest(url, args[0], &location_loader_);
+  }
+
+  void HandleWeather(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    const base::Value& callback_id = args[0];
+    if (args.size() != 3u || !args[1].is_string() || !args[2].is_string()) {
+      RejectJavascriptCallback(callback_id,
+                               base::Value("Invalid weather arguments"));
+      return;
+    }
+
+    double latitude = 0;
+    double longitude = 0;
+    if (!base::StringToDouble(args[1].GetString(), &latitude) ||
+        !base::StringToDouble(args[2].GetString(), &longitude) ||
+        latitude < -90 || latitude > 90 || longitude < -180 ||
+        longitude > 180) {
+      RejectJavascriptCallback(callback_id,
+                               base::Value("Invalid weather coordinates"));
+      return;
+    }
+
+    GURL url(kAgentSearchWeatherEndpoint);
+    url = net::AppendQueryParameter(url, "latitude", args[1].GetString());
+    url = net::AppendQueryParameter(url, "longitude", args[2].GetString());
+    url = net::AppendQueryParameter(url, "current",
+                                    "temperature_2m,weather_code");
+    url = net::AppendQueryParameter(url, "temperature_unit", "fahrenheit");
+    url = net::AppendQueryParameter(url, "timezone", "auto");
+    StartWeatherRequest(url, callback_id, &weather_loader_);
+  }
+
+  void StartWeatherRequest(
+      const GURL& url,
+      const base::Value& callback_id,
+      std::unique_ptr<network::SimpleURLLoader>* loader) {
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = url;
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    net::NetworkTrafficAnnotationTag traffic_annotation =
+        net::DefineNetworkTrafficAnnotation("agentsearch_dashboard_weather", R"(
+          semantics {
+            sender: "AgentSearch new tab dashboard"
+            description:
+              "Fetches approximate location and current weather for the "
+              "new tab dashboard."
+            trigger: "A user opens the AgentSearch new tab page."
+            data: "IP-derived approximate location or latitude and longitude."
+            destination: OTHER
+          }
+          policy {
+            cookies_allowed: NO
+            setting: "This is part of the AgentSearch new tab dashboard."
+            policy_exception_justification:
+              "No enterprise policy is provided for dashboard weather."
+          })");
+    *loader = network::SimpleURLLoader::Create(std::move(request),
+                                               traffic_annotation);
+    (*loader)->DownloadToString(
+        web_ui()->GetWebContents()
+            ->GetBrowserContext()
+            ->GetDefaultStoragePartition()
+            ->GetURLLoaderFactoryForBrowserProcess()
+            .get(),
+        base::BindOnce(&AgentSearchMessageHandler::OnWeatherRequestComplete,
+                       weak_ptr_factory_.GetWeakPtr(), callback_id.Clone()),
+        kAgentSearchWeatherMaxResponseBytes);
+  }
+
+  void OnWeatherRequestComplete(base::Value callback_id,
+                                std::optional<std::string> body) {
+    if (!body) {
+      RejectJavascriptCallback(callback_id,
+                               base::Value("Weather request failed"));
+      return;
+    }
+    ResolveJavascriptCallback(callback_id, base::Value(std::move(*body)));
+  }
+
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  std::unique_ptr<network::SimpleURLLoader> location_loader_;
+  std::unique_ptr<network::SimpleURLLoader> weather_loader_;
+  std::unique_ptr<network::SimpleURLLoader> oauth_token_loader_;
+  std::unique_ptr<network::SimpleURLLoader> oauth_userinfo_loader_;
+  std::unique_ptr<AgentSearchOAuthNavigationObserver> oauth_observer_;
+  std::string oauth_state_;
+  raw_ptr<Profile> profile_ = nullptr;
+  PrefChangeRegistrar pref_change_registrar_;
+  base::WeakPtrFactory<AgentSearchMessageHandler> weak_ptr_factory_{this};
+};
 
